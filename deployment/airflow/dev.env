# Executor
AIRFLOW__CORE__EXECUTOR=CeleryExecutor

# Database (Postgres)
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:postgres@localhost:5432/airflow_2

# UI
AIRFLOW__WEBSERVER__PORT=8089
AIRFLOW__CORE__LOAD_EXAMPLES=False

