# ══════════════════════════════════════════════════════════════════════════════
# manual.env — shared config for all manual scripts
# Each script reads only the variables it needs from its own section below.
# This file is separate from Airflow/.env (the pipeline config).
# ══════════════════════════════════════════════════════════════════════════════


# ══════════════════════════════════════════════════════════════════════════════
# manual_decryption.py
# ══════════════════════════════════════════════════════════════════════════════
DECRYPT_SOURCE_CONN=mssql+pyodbc://<user>:<password>@<host>:<port>/<source_db>?driver=ODBC+Driver+17+for+SQL+Server
DECRYPT_DEST_CONN=mssql+pyodbc://<user>:<password>@<host>:<port>/<dest_db>?driver=ODBC+Driver+17+for+SQL+Server
DECRYPT_SOURCE_TABLE=progressnotes
DECRYPT_DEST_TABLE=progressnotes_decrypted
DECRYPT_BATCH_SIZE=1000
DECRYPT_MAX_WORKERS=10


# ══════════════════════════════════════════════════════════════════════════════
# manual_merge_script.py
# ══════════════════════════════════════════════════════════════════════════════
MERGE_DB_TYPE=mysql
MERGE_MAIN_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<base_db>
MERGE_DIFF_STAGING_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<diff_staging_db>
MERGE_DIFF_MERGED_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<diff_merged_db>
MERGE_DEFAULT_DATE=2026-01-01 00:00:00
MERGE_PK_CSV=/path/to/input/primary_keys.csv
MERGE_STATUS_CSV=/path/to/manual_merge_status.csv


# ══════════════════════════════════════════════════════════════════════════════
# add_nd_columns.py
# ══════════════════════════════════════════════════════════════════════════════
ADD_ND_CONN=mssql+pymssql://<user>:<password>@<host>:<port>/<db>
ADD_ND_TABLES_FILE=/path/to/input/tables.csv
ADD_ND_LOG_FILE=/path/to/state/adhoc/add_nd_columns_log.csv
ADD_ND_DEFAULT_DATE=2026-01-01 00:00:00


# ══════════════════════════════════════════════════════════════════════════════
# remove_constraint_mssql.py
# ══════════════════════════════════════════════════════════════════════════════
CONSTRAINT_CONN=mssql+pymssql://<user>:<password>@<host>:<port>/<db>
CONSTRAINT_TABLES_FILE=/path/to/input/tables.csv
CONSTRAINT_LOG_FILE=/path/to/state/adhoc/constraint_removal_log.csv


# ══════════════════════════════════════════════════════════════════════════════
# manual_deidentification_run_v2.py
# ══════════════════════════════════════════════════════════════════════════════
DEID_PYTHON=/opt/miniconda3/envs/new_deid/bin/python
DEID_V2_CONFIG=/path/to/scripts/configs/config_historical.yaml
DEID_V2_TABLES=/path/to/input/tables.csv


# ══════════════════════════════════════════════════════════════════════════════
# row_count_ignored_report.py
# ══════════════════════════════════════════════════════════════════════════════
REPORT_MSSQL_CONN=mssql+pyodbc://<user>:<password>@<host>:<port>/<source_db>?driver=ODBC+Driver+17+for+SQL+Server
REPORT_MYSQL_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<deid_base_db>
REPORT_TABLES_CSV=/path/to/input/tables.csv
REPORT_STATE_DIR=/path/to/production_state/state
REPORT_DEID_CONFIG=/path/to/scripts/configs/config.yaml


# ══════════════════════════════════════════════════════════════════════════════
# copy_prod_to_base.py (v1, same-instance) · copy_prod_to_base_v2.py (v2, cross-instance)
# Both read the same COPY_PROD_* vars; PROD is only ever READ, all writes go to BASE.
# v1 requires SOURCE and DEST on the SAME MSSQL instance (server-side copy) and the
# sp_remove_identity_columns_final_updated proc to exist in the BASE db. v2 streams
# rows through Python (SOURCE/DEST may be remote) and needs no stored proc.
# ══════════════════════════════════════════════════════════════════════════════
COPY_PROD_SOURCE_CONN=mssql+pyodbc://<user>:<password>@<host>:<port>/<prod_db>?driver=ODBC+Driver+17+for+SQL+Server
COPY_PROD_DEST_CONN=mssql+pyodbc://<user>:<password>@<host>:<port>/<base_db>?driver=ODBC+Driver+17+for+SQL+Server
COPY_PROD_TABLES_FILE=/path/to/input/tables.csv
COPY_PROD_LOG_FILE=/path/to/state/adhoc/copy_prod_to_base_log.csv
COPY_PROD_DEFAULT_DATE=2026-01-01 00:00:00
# Optional — default next to COPY_PROD_LOG_FILE; leave COPY_PROD_DETAIL_LOG unset for a timestamped log per run.
COPY_PROD_COMPLETED_CSV=/path/to/input/copy_prod_to_base_completed.csv
# COPY_PROD_DETAIL_LOG=
COPY_PROD_BATCH_SIZE=50000
COPY_PROD_PROGRESS_INTERVAL=15
