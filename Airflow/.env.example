# ════════════════════════════════════════════════════════════════════════════
# AIRFLOW DEID — environment template
#
# TOP    : variables REQUIRED by the active mind-branch pipelines
#          (eCW / Greenway / MIND / dent).
# BOTTOM : everything after the ░░░ divider is NOT used by the active pipelines —
#          legacy athena/veradigm clients + manual utility scripts. Usually unset.
#
# ── PASSWORD RULE (applies to EVERY *_PASS / *_PASSWORD below) ────────────────
# Store passwords RAW and LITERAL — exactly the characters the database expects.
# NEVER percent-encode here. Write  @  as  @  (NOT %40),  #  as  #, etc.
# The code URL-encodes exactly once when it builds the connection (via
# sqlalchemy URL.create in scripts/db_url.py), so any special char works.
# A pre-encoded value like `%40` is now sent LITERALLY and WILL fail auth.
# If a value contains a space or a trailing '#', wrap the whole value in quotes
# ("p@ss word"); a bare '#' with a leading space starts an inline comment.
# ════════════════════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════
# PRACTICE IDENTITY  (set per-machine — drives client config YAML selection)
# ══════════════════════════════════════════════════════════════
# Greenway practices : mind | jwm | savannah
# eCW practices      : dent | northwest | texas | fcn | tncne | arizona
# AthenaOne          : raleigh | tncpa | dcnd | tng
PRACTICE_NAME=<practice_name>

# ══════════════════════════════════════════════════════════════
# ALERTING
# ══════════════════════════════════════════════════════════════
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/<space>/messages?key=<key>&token=<token>

# ══════════════════════════════════════════════════════════════
# PRIMARY SOURCE-ENGINE KNOB  (set alongside PRACTICE_NAME above)
# ══════════════════════════════════════════════════════════════
# Engine of the CLIENT SOURCE database the pipeline READS: mysql | mssql.
# Drives every *_config_incremental/_historical.yaml `source_db` and the eCW /
# mind / greenway delta, decrypt and mapping/master scripts. The working and
# destination databases are ALWAYS MySQL regardless of this setting.
SOURCE_DB_TYPE=mysql

# Python executable for new deidentification code (new_deid conda env)
DEID_PYTHON=/opt/miniconda3/envs/new_deid/bin/python

# ══════════════════════════════════════════════════════════════
# STATE DIRECTORY
# ══════════════════════════════════════════════════════════════
STATE_DIR=/path/to/airflow-automation/state

# Path to the deid engine repo (the `deidentification_v2` dir that contains the
# `deid/` package) — used by the dent CDC scripts (CDC/MySQL) and state init/status
# scripts, and prepended to PYTHONPATH by manual_deidentification_run_v2.py so
# `python -m deid` runs THIS checkout's code rather than whatever is pip-installed.
# When several checkouts (V2/V3/...) share one conda env, point this at the one
# you want to run on this machine.
DEID_REPO_DIR=/path/to/deidentification_v2/

# ══════════════════════════════════════════════════════════════
# MERGE CONFIG
# ══════════════════════════════════════════════════════════════
PK_CSV=/path/to/input/primary_keys.csv
HISTORICAL_DATA_DEFAULT_DATE=2026-03-11 00:00:00

# ══════════════════════════════════════════════════════════════
# DATABASE CONNECTIONS  (primitives — db_config.py + the YAML configs build
# every connection string / dict from these; there are no full conn-strings here)
# ══════════════════════════════════════════════════════════════

# ── SOURCE DB — the client's data, READ side (engine = SOURCE_DB_TYPE) ──
# SOURCE_DB_HOST falls back to DB_HOST when blank (the source is usually local).
SOURCE_DB_HOST=
SOURCE_DB_PORT=3306
SOURCE_DB_USER=<source_db_user>
SOURCE_DB_PASS=<source_db_password>
# ODBC driver — used only when SOURCE_DB_TYPE=mssql (pyodbc). URL-encoded into
# every MSSQL connection in code. `odbcinst -q -d` lists installed drivers.
ODBC_DRIVER=ODBC Driver 17 for SQL Server

# ── WORKING / DESTINATION DB — ALWAYS MySQL, WRITE side ─────────
# deid staging + mapping + master tables are always written here.
DB_HOST=<mysql_working_host>
DB_PORT=3306
DB_USER=<mysql_user>
DB_PASS=<mysql_password>

# ── UPSTREAM PROD MSSQL — remote source for mapping/master delta (greenway/mind) ──
# Each PROD_* defaults to its SOURCE_DB_* counterpart (+ ODBC_DRIVER) when blank:
#   PROD_HOST → SOURCE_DB_HOST → DB_HOST ; PROD_USER/PROD_PASS/PROD_PORT → SOURCE_DB_*.
# Leave all blank for a local source that shares the source credentials. Set the
# PROD_USER/PROD_PASS/PROD_PORT overrides ONLY when the remote prod uses DIFFERENT
# credentials or port than the source DB.
PROD_HOST=
PROD_USER=
PROD_PASS=
PROD_PORT=

# ══════════════════════════════════════════════════════════════
# SQL FILES
# ══════════════════════════════════════════════════════════════
MAPPING_SQL_FILE=/path/to/Airflow/scripts/sql/mapping_greenway.sql
MASTER_PII_SQL_FILE=/path/to/Airflow/scripts/sql/master_pii_data_query_greenway.sql
MASTER_INSURANCE_SQL_FILE=/path/to/Airflow/scripts/sql/master_insurance_query_greenway.sql

# ══════════════════════════════════════════════════════════════
# DEID CONFIG
# ══════════════════════════════════════════════════════════════
# Days to shift dates during de-identification (integer)
DATE_OFFSET=<days_to_offset_dates>
# Local directory for deid state DB (state.db) and run logs
LOG_DIR=/path/to/airflow-automation/deid_logs

# ══════════════════════════════════════════════════════════════
# DATABASE SCHEMA NAMES  (used as string args to scripts and YAML configs)
# ══════════════════════════════════════════════════════════════
# ── Source DB names — the databases the pipeline READS. Names differ per
#    client but the convention is shared (one client per machine, so set only
#    what that client's config uses):
#      eCW / dent (mysql)        : STAGING_DB_NAME (delta) + PROD_DB_NAME (full DB, for FK joins)
#      Greenway / MIND / JWM (mssql): MERGED_DB_NAME (source) + PROD_DB_NAME (for FK joins)
STAGING_DB_NAME=<staging_or_delta_db>
MERGED_DB_NAME=<mssql_diff_merged_db>
PROD_DB_NAME=<production_db_for_reference_joins>
# ── MySQL working / output DB names ────────────────────────────
MAPPING_DB_NAME=mapping
MASTER_DB_NAME=master
DEID_STAGING_NAME=deidentified_staging
DEID_BASE_NAME=<deid_base_db_name>
# ── Greenway-specific schema names ─────────────────────────────
CLINICALBIN_DB_NAME=<clinicalbin_decrypted_mysql_db>

# ══════════════════════════════════════════════════════════════
# TABLES CSV (one per DAG)
# ══════════════════════════════════════════════════════════════
DIFF_MERGE_TABLES_CSV=/path/to/input/tables.csv
DEID_TABLES_CSV=/path/to/input/tables.csv
DEID_POST_PROCESS_TABLES_CSV=/path/to/input/tables.csv
CLINICALBIN_TABLES_CSV=/path/to/input/clinicalbin_tables.csv

# ══════════════════════════════════════════════════════════════
# DEID YAML CONFIG PATHS  (substituted into config YAML files via ${VAR})
# ══════════════════════════════════════════════════════════════
# Rules CSVs — define which columns are PHI and how to de-identify them
RULES_CSV=/path/to/scripts/greenway/greenway_config_rules.csv
CNOTES_RULES_CSV=/path/to/scripts/greenway/cnotes_config_rules.csv
# PII config YAMLs — point to the correct EHR folder on each machine
PII_YAML=/path/to/scripts/greenway/greenway_pii_config.yaml
SECONDARY_PII_YAML=/path/to/scripts/greenway/greenway_secondary_pii_config.yaml
REF_MAPPING_YAML=/path/to/scripts/greenway/greenway_reference_mappings.yaml

# Per-client facility redactions injected into every pii_config's `replace_value`.
# A JSON list of {old_value, new_value} dicts, parsed by the deid config loader
# (a whole-value ${VAR} that is valid JSON is expanded to the list). Values differ
# per client — set this on each machine. Example below is for the Dent (eCW) practice:
REPLACE_VALUE_JSON=[{"old_value": "Dent Institute", "new_value": "((FACILITYNAME))"}, {"old_value": "DENT", "new_value": "((FACILITYNAME))"}, {"old_value": "www.dentinstitute.com", "new_value": "((FACILITY_WEBSITE))"}]

# ══════════════════════════════════════════════════════════════
# AUTO-QC  (deid QC framework → CSVs; dags/<vendor>/<vendor>_auto_qc_dag.py)
# ══════════════════════════════════════════════════════════════
# Per table, runs Part 1 (structured/unstructured scan) + Part 2 (mapping/count gate +
# delta-identity) + Part 3 (master PHI audit), writing auto_qc_summary_<ts>.csv +
# auto_qc_findings_<ts>.csv to AUTO_QC_OUT_DIR. The DAG shells out to `python -m deid auto-qc`
# in DEID_PYTHON's env (DEID_REPO_DIR is prepended to PYTHONPATH, same as the deid runner).
# All have code defaults — set only to override.
#
# PHI rules CSV (table_name,column_name,rule) — defaults to RULES_CSV above:
# AUTO_QC_RULES_CSV=/path/to/scripts/<vendor>/<vendor>_config_rules.csv
# deid config.yaml — defaults to scripts/<vendor>/<vendor>_config_incremental.yaml:
# AUTO_QC_CONFIG=/path/to/scripts/<vendor>/<vendor>_config_incremental.yaml
# Where the two CSVs are written — defaults to STATE_DIR/auto_qc/<vendor>:
# AUTO_QC_OUT_DIR=/path/to/airflow-automation/state/auto_qc/<vendor>
# Tables to QC — defaults to DEID_POST_PROCESS_TABLES_CSV; empty → every table in the rules CSV:
# AUTO_QC_TABLES_CSV=/path/to/input/tables.csv
# Tables QC'd concurrently (thread pool):
AUTO_QC_MAX_WORKERS=4
# Residual-PII scanner backend: regex (default) | none
# AUTO_QC_RESIDUAL_BACKEND=regex
# PHI master connection for Part 3 + notes exact-match. Blank → uses qc.master_phi in the config yaml:
# AUTO_QC_PII_MASTER_CONN_STR=mysql+pymysql://<user>:<password>@<host>:<port>/master
# Delta-identity: only check dest rows with delta_col > this (blank → all delta rows):
# AUTO_QC_DELTA_AFTER=
# Skip the Part-2 mapping & count gate (1/true/yes):
# AUTO_QC_NO_GATE=0

# ══════════════════════════════════════════════════════════════
# ATHENAONE INGESTION  (athenaone/snowflake_ingest.py + ingest/*.py)
# ══════════════════════════════════════════════════════════════
# AthenaOne has no SMB dump / MSSQL restore / diff-merge — it ingests via a
# Snowflake → MySQL pull. Set these only on an AthenaOne machine. Passwords are
# URL-encoded in code, so store PLAIN values here.
ATHENAONE_SNOWFLAKE_USER=<snowflake_user>
ATHENAONE_SNOWFLAKE_PASSWORD=<snowflake_password>
ATHENAONE_SNOWFLAKE_ACCOUNT=<snowflake_account>
ATHENAONE_SNOWFLAKE_DATABASE=ATHENAHEALTH
ATHENAONE_SNOWFLAKE_WAREHOUSE=AH_WAREHOUSE
ATHENAONE_SNOWFLAKE_INSECURE_MODE=true
# MySQL landing target for the pull. Falls back to DB_USER/DB_PASS/DB_HOST when blank.
ATHENAONE_MYSQL_HOST=
ATHENAONE_MYSQL_USER=
ATHENAONE_MYSQL_PASSWORD=
# Schema recreated fresh each run, then merged into the historical schema.
ATHENAONE_INCREMENTAL_SCHEMA=dump_incremental
ATHENAONE_HISTORICAL_SCHEMA=athenaone
# Extraction tuning
ATHENAONE_CONTEXT_IDS=1,23649
ATHENAONE_INGEST_BATCH_SIZE=10000
ATHENAONE_INGEST_MAX_THREADS=10
# Optional: restrict to specific tables (comma list) / pin the date window.
ATHENAONE_TEST_TABLES=
ATHENAONE_EXTRACTION_DATE=
ATHENAONE_FROM_DATE=
ATHENAONE_TO_DATE=
# VPN — the Snowflake pull runs over the practice OpenVPN tunnel. The DAG brings
# the tunnel up before the ingest and always tears it down after (even on
# failure). Needs passwordless sudo for openvpn/killall (see setup_vpn.sh).
# Set skip_vpn: true in clients/<practice>.yaml on a machine that has no tunnel.
ATHENAONE_OPENVPN_BIN=/opt/homebrew/sbin/openvpn
ATHENAONE_OPENVPN_CONFIG=/etc/openvpn/nd-platform.ovpn
ATHENAONE_OPENVPN_LOG=/tmp/openvpn_airflow.log
ATHENAONE_VPN_CONNECT_TIMEOUT=60
#
# NOTE: on an AthenaOne machine, also point the shared deid YAML path vars
# (PII_YAML / SECONDARY_PII_YAML / REF_MAPPING_YAML / RULES_CSV above) at
# scripts/athenaone/*, and set the legacy MAPPING_SOURCE_* / MASTER_*_CONN /
# MAPPING_CONFIG_FILE (below the ░ divider) used by the v5 mapping/master scripts.

# ══════════════════════════════════════════════════════════════
# DAILY DUMP  (unified scripts/daily_dump.py — set per-machine in .env)
#
# One script + one DAG (dag_id "daily_dump") for every machine. Pick the source
# with DUMP_SOURCE_TYPE; only the block for that source needs values filled in.
#
#   DUMP_SOURCE_TYPE = shared_folder | azure_blob | check_folder
#   DUMP_SKIP        = 1 to disable the dump on this machine (default: run)
#   DUMP_SCHEDULE    = cron for the DAG (default "0 1 * * *" = 01:00 Asia/Kolkata)
# ══════════════════════════════════════════════════════════════
DUMP_SOURCE_TYPE=shared_folder
DUMP_SKIP=0
# DUMP_SCHEDULE=0 1 * * *

# ── shared_folder (SMB) ───────────────────────────────────────
#   Greenway / Mind   : SMB_SHARE=mind-sql/SQL Backups     SMB_SOURCE_FOLDER_NAME=SQLBackups
#   eCW               : SMB_SHARE=cns-ecw-db01/SQL_Backups  SMB_SOURCE_FOLDER_NAME=CNS-ECW-DB01
SMB_SHARE=<host>/<share_name>
SMB_USERNAME=<smb_username>
SMB_PASSWORD=<smb_password>
SMB_SOURCE_FOLDER_NAME=<source_folder_on_smb_share>
# Where copied files land (was hardcoded per-machine before; now required):
DUMP_LOCAL_DEST=/Volumes/NDAIVol2/MSSQL2019/Dump
# Copy behaviour: log_sync (keep only LOG/ per DB) | latest_bak (newest *.bak, prune) | mirror
DUMP_COPY_MODE=log_sync
# Optional overrides (defaults shown):
# DUMP_MOUNT_POINT=/tmp/data_dump_smb
# DUMP_VOLUME_MOUNT_POINT=/Volumes/SQL Backups/
# DUMP_LOG_SUBDIR=LOG
# DUMP_BAK_GLOB=*.bak

# ── azure_blob ────────────────────────────────────────────────
# Full container SAS URL, e.g. https://<account>.blob.core.windows.net/<container>?<sas>
# DUMP_AZURE_SAS_URL=<container_sas_url>
# DUMP_AZURE_PREFIX=
# DUMP_AZURE_ONLY_ZIP=0
#   (azure_blob also uses DUMP_LOCAL_DEST above as the download directory)

# ── check_folder (monitor only — no copy, e.g. Dent binary logs) ──
# DUMP_CHECK_FOLDER=/Volumes/NDAIVol/BinaryLog/
# DUMP_CHECK_WINDOW_DAYS=1
# DUMP_CHECK_TZ=Asia/Kolkata
# DUMP_CHECK_REQUIRE_FILES=0   # 1 = fail the task (alert) when nothing landed

# ── unzip (optional post-dump step) ───────────────────────────
# Some sources deliver zipped dumps. When enabled, the dump DAG's
# check_unzip_required → unzip tasks extract archives into a SEPARATE folder.
# Leave DUMP_UNZIP_ENABLED unset/0 on machines that receive plain files.
DUMP_UNZIP_ENABLED=0
# Folder to scan for archives (defaults to DUMP_LOCAL_DEST if unset):
# DUMP_UNZIP_SOURCE=/Volumes/NDAIVol/Data Dump/Data
# Separate destination folder for the extracted contents (required when enabled):
# DUMP_UNZIP_DEST=/Volumes/NDAIVol/Data Dump/Extracted
# Optional overrides (defaults shown):
# DUMP_UNZIP_PATTERN=*.zip
# DUMP_UNZIP_RECURSIVE=1          # search DUMP_UNZIP_SOURCE recursively
# DUMP_UNZIP_DELETE_ORIGINAL=0    # 1 = delete each .zip after it extracts

# ══════════════════════════════════════════════════════════════
# MSSQL LOG RESTORE  (shared restore_incremental_logs.py + check_db_availability.py)
#
# One shared script + one standalone DAG (dag_id "daily_restore", present in each
# MSSQL EHR folder: greenway / ecw / mind) apply the .trn logs dumped by the
# daily_dump DAG.  The database list is env-driven so no code changes per machine.
#
# The same restore can ALSO run inside the pipeline DAG (gated by skip_restore).
# To avoid double-restoring, enable exactly ONE path per machine:
#   • standalone daily_restore DAG  → leave RESTORE_SKIP unset, set the pipeline's
#     skip_restore=true (client YAML / params)
#   • pipeline restore              → set RESTORE_SKIP=1 here
# ══════════════════════════════════════════════════════════════
# Skip the standalone daily_restore DAG on this machine (1/true/yes):
RESTORE_SKIP=0
# Cron for the daily_restore DAG (default 01:30 Asia/Kolkata, after the 01:00 dump):
# RESTORE_SCHEDULE=30 1 * * *
#
# Databases to restore — JSON array; one object per DB.
#   Required per entry : db_name (TARGET db), standby_file, trn_dir
#   Optional per entry : source_db_name (db name INSIDE the backups — only needed
#                        when trn_dir holds logs for >1 database, e.g. a shared
#                        parent), applied_logs_csv (defaults to
#                        DATA_LOGS_DIR/applied_logs_<db_name>.csv)
#   Greenway example (two DBs):
# RESTORE_DB_CONFIGS=[{"db_name":"Primerecord_Latest","source_db_name":"PrimeRecord1697","standby_file":"/var/opt/mssql/undo/PrimeRecord_standby.undo","trn_dir":"/var/opt/mssql/dump/SQLBackups/PrimeRecord1697/LOG/"},{"db_name":"PrimerecordBin_Latest","source_db_name":"PrimeRecordBin1697","standby_file":"/var/opt/mssql/undo/PrimeRecordBin_standby.undo","trn_dir":"/var/opt/mssql/dump/SQLBackups/PrimeRecordBin1697/LOG/"}]
RESTORE_DB_CONFIGS=<json_array_of_db_restore_configs>
#
# Log ordering: lsn (default; reads backup headers, orders by LSN, detects gaps)
# or filename (legacy; sorts by the _YYYYMMDD_HHMMSS name — cannot detect gaps).
# RESTORE_ORDER_MODE=lsn
# Search trn_dir recursively (default 1) or only its top level (0):
# RESTORE_TRN_RECURSIVE=1
#
# Directory holding the applied-log CSVs (and default location for them):
DATA_LOGS_DIR=/path/to/airflow-automation/deid_runtime/dataLogs
# Dry run: 1/true/yes = log intended actions without applying
RESTORE_DRY_RUN=0
# sqlcmd target host/container + SA auth
SQL_SERVER_CONTAINER=localhost
SQLCMD_CONTAINER=<sqlcmd_container_id_or_name>
SA_USER=sa
SA_PASS=<mssql_sa_password>
SQLCMD_BIN=/opt/mssql-tools18/bin/sqlcmd
#
# Legacy single-DB fallback (used only when RESTORE_DB_CONFIGS is unset):
#   RESTORE_LOGS_DB=<db>   STANDBY_FILE=/var/opt/mssql/undo/<db>_standby.undo
#   TRN_DIR=/var/opt/mssql/backups   APPLIED_LOGS_FILE=<path>/applied_logs.csv

# ══════════════════════════════════════════════════════════════
# CLINICAL NOTES DECRYPT  (greenway/decrypt_cnotes.py + clinicalbin_delta_staging.py)
# ══════════════════════════════════════════════════════════════
# Source MSSQL connection for raw (encrypted) cnotes.
# The ODBC driver is applied from ODBC_DRIVER (above) in code — no need to set
# driver= here; anything you put will be overridden to match ODBC_DRIVER.
CNOTES_SOURCE_CONN=mssql+pyodbc://<user>:<password>@<host>:<port>/<db>
# Dest MySQL connection for decrypted cnotes staging
CNOTES_DEST_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<db>
# Linked server name on the MSSQL side (default: Primerecord_Latest)
CNOTES_LINKED_DB=Primerecord_Latest
# Optional: override batch size (default set in script)
CNOTES_BATCH_SIZE=500

# ── cnotes sub-flow control ───────────────────────────────────────────────────
# These are the MIND defaults (mind has no client config). Greenway/ecw source
# skip_cnotes + cnotes_first from scripts/<ehr>/clients/<practice>.yaml instead.
#   SKIP_CNOTES  → default for the skip_cnotes UI checkbox (runtime; cnotes_gate
#                  skips the whole cnotes chain when true — overridable per-run in UI)
#   CNOTES_FIRST → parse-time ordering: true runs cnotes BEFORE the main deid
#                  (default: after). Structural — NOT a UI toggle.
# Truthy = 1/true/yes (case-insensitive). Unset = false.
SKIP_CNOTES=false
CNOTES_FIRST=false
# Optional PK CSV for the cnotes merge step; empty → falls back to PK_CSV.
CNOTES_PK_CSV=

# ══════════════════════════════════════════════════════════════
# SOURCE DATABASE ENGINE  (configured at the top of this file)
# ══════════════════════════════════════════════════════════════
# The source engine + credentials live in SOURCE_DB_TYPE and the SOURCE_DB_*
# family near the top. All client-source configs (*_config_incremental /
# *_config_historical.yaml) and the eCW / mind / greenway delta, decrypt and
# mapping/master scripts read from those. mysql → SOURCE_DB_PORT=3306 ;
# mssql → SOURCE_DB_PORT=1433 (+ ODBC_DRIVER). Nothing to set in this section.

# ══════════════════════════════════════════════════════════════
# DECRYPTION KEY  (decrypt_pnotes.py · state_diff_decryption.py · manual_decryption.py)
# ══════════════════════════════════════════════════════════════
# Quote the value if it contains special characters such as # or @.
DEID_DECRYPT_KEY="<blowfish_decryption_key>"

# ══════════════════════════════════════════════════════════════
# AWS S3 TRANSFER  (s3_transfer.py · task_s3_transfer in all pipeline DAGs)
# ══════════════════════════════════════════════════════════════
AWS_ACCESS_KEY_ID=<aws_access_key_id>
AWS_SECRET_ACCESS_KEY=<aws_secret_access_key>
AWS_REGION=<aws_region>
S3_BUCKET=<s3_bucket_name>
# ── S3 key prefixes ──────────────────────────────────────────────────────────
# The per-run MMDDYYYY date folder is appended automatically to each.
#
# LEGACY s3_transfer.py (dent flow) reads S3_DESTINATION_PREFIX (default "EHR").
S3_DESTINATION_PREFIX=EHR/nd_incremental
#
# state_s3_transfer.py (the state pipelines: ecw/greenway/mind) reads these two —
# the dump payload and the count report live under SEPARATE prefixes so they don't
# collide. If unset it falls back to these exact defaults:
#   S3_INCREMENTAL_DUMP_PATH_PREFIX → {prefix}/{MMDDYYYY}/{schema}/{table}.sql + sql_dump_stats.csv
#   S3_COUNT_REPORT_PATH_PREFIX     → {prefix}/{MMDDYYYY}/count_report.csv
S3_INCREMENTAL_DUMP_PATH_PREFIX=EHR/nd_incremental
S3_COUNT_REPORT_PATH_PREFIX=EHR/merge_stats
# Local staging directory where deidentified data is written before S3 upload
DATA_TRANSFER_BASE_PATH=/Volumes/NDAIVol/S3 Transfer

# ══════════════════════════════════════════════════════════════
# ADDITIONAL ACTIVE-PIPELINE VARS  (all have code defaults — set to override)
# ══════════════════════════════════════════════════════════════
# db_config.py connection-string components (PROD_HOST is in the DATABASE
# CONNECTIONS section above — remote-prod host for mapping/master delta).
BASE_DB_NAME=<mssql_base_db>
DEID_MERGED_NAME=deidentified_merged

# dent CDC pipeline (dags/dent/cdc_automation_dag.py)
DB_CDC_SCHEMA=cdc

# Provider dashboard DAG (dags/mind/provider_dashboard.py)
DASHBOARD_PROJECT_DIR=/path/to/dashboards

# Standalone MSSQL log/backup restore (scripts/restore_incremental_logs.py · restore_backups.py)
RESTORE_LOGS_DB=<mssql_db_being_restored>
STANDBY_FILE=/var/opt/mssql/undo/<db>_standby.undo
TRN_DIR=/var/opt/mssql/backups
TRN_GLOB=*.trn
APPLIED_LOGS_FILE=/path/to/airflow-automation/deid_runtime/dataLogs/applied_logs.csv
BAK_DIR=/var/opt/mssql/dump/Full


# ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
# BELOW THIS LINE — NOT required by the active mind-branch pipelines
# (eCW / Greenway / MIND / dent). Legacy clients + manual utilities only.
# Leave these unset on machines that run only the active pipelines.
# ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░

# ══════════════════════════════════════════════════════════════
# LEGACY — athena / athenapractice / veradigm clients on the v3/v4/v5 engine
#   (incremental_mapping_update_v3/v4/v5.py · master_recreate_v3.py · athenaone/*)
# Role-based connection vars read by db_config's legacy compatibility shim.
# ══════════════════════════════════════════════════════════════
# Mapping engine — source DB (mssql OR mysql) + destination (always MySQL)
MAPPING_SOURCE_HOST=<legacy_source_host>
MAPPING_SOURCE_PORT=1433
MAPPING_SOURCE_DATABASE=<legacy_source_db>
MAPPING_SOURCE_USER=<legacy_source_user>
MAPPING_SOURCE_PASSWORD=<legacy_source_password>
MAPPING_DEST_HOST=<legacy_dest_mysql_host>
MAPPING_DEST_PORT=3306
MAPPING_DEST_DATABASE=<legacy_mapping_mysql_db>
MAPPING_DEST_USER=<legacy_dest_user>
MAPPING_DEST_PASSWORD=<legacy_dest_password>
MAPPING_CONFIG_FILE=/path/to/Airflow/scripts/configs/<client>/mapping_master_config_<client>.yaml
# Master recreate — full SQLAlchemy connection strings
MASTER_SOURCE_CONN=mssql+pymssql://<user>:<password>@<host>:<port>/<source_db>
MASTER_DEST_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<master_db>
MASTER_MAPPING_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<mapping_db>
# DB-details model name — only the removed Django/polar runner used this
DBDETAILSMODEL_NAME=<db_details_model_name>

# ══════════════════════════════════════════════════════════════
# MANUAL / UTILITY SCRIPTS  (not used by Airflow DAGs)
# ══════════════════════════════════════════════════════════════

# diff_script_optimised.py · diff_script_duplicate_pk_handled.py
MSSQL_OLD_CONN=mssql+pyodbc://<user>:<password>@<host>:<port>/<old_db>?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
MSSQL_NEW_CONN=mssql+pyodbc://<user>:<password>@<host>:<port>/<new_db>?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
MSSQL_DIFF_CONN=mssql+pyodbc://<user>:<password>@<host>:<port>/<diff_db>?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes

# row_count_comparison.py
MSSQL_CONN=mssql+pyodbc://<user>:<password>@<host>:<port>/<db>?driver=ODBC+Driver+17+for+SQL+Server
MYSQL_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<db>

# deid_output_comparison.py
MYSQL_OLD_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<old_deid_db>
MYSQL_NEW_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<new_deid_db>
MYSQL_DIFF_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<diff_db>

# gcp_count.py (adhoc)
MYSQL_PASSWORD=<mysql_password>

# deid_base_run_and_purge DAG (run deid -> row-count check -> drop merged tables)
# Defaults for the DAG's two trigger params (overridable per-run in the Airflow UI).
DEID_BASE_PURGE_CONFIG=/path/to/scripts/<vendor>/<vendor>_config_historical.yaml
DEID_BASE_PURGE_TABLES_CSV=/path/to/input/tables.csv

# ndid_controlno_pipeline DAG (dags/ndid_controlno.py)
# Connections come from DB_* (mapping/output MySQL), SOURCE_DB_* (patients
# MSSQL) and PROD_DB_NAME above — no extra connection vars needed.
# Optional input CSV path; per-run conf {"csv_path": ...} wins, and when both
# are unset it falls back to dags/nd_patient_ids.csv next to the DAG.
# NDID_CSV_PATH=/path/to/nd_patient_ids.csv
