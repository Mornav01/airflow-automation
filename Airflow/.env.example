# ══════════════════════════════════════════════════════════════
# DEID V2 CREDENTIALS (used by scripts/configs/config.yaml)
# ══════════════════════════════════════════════════════════════
SOURCE_USER=<mssql_source_username>
SOURCE_PW=<mssql_source_password>
DEST_USER=<mysql_dest_username>
DEST_PW=<mysql_dest_password>

# Python executable for new deidentification code (new_deid conda env)
DEID_PYTHON=/opt/miniconda3/envs/new_deid/bin/python

# ══════════════════════════════════════════════════════════════
# STATE DIRECTORY
# ══════════════════════════════════════════════════════════════
STATE_DIR=/path/to/airflow-automation/state

# Path to old polar deidentification code
DEID_REPO_DIR=/path/to/deidentification_v2/

# ══════════════════════════════════════════════════════════════
# MERGE CONFIG
# ══════════════════════════════════════════════════════════════
PK_CSV=/path/to/input/primary_keys.csv
HISTORICAL_DATA_DEFAULT_DATE=2026-03-11 00:00:00

# ══════════════════════════════════════════════════════════════
# DATABASE CONNECTION STRINGS
# ══════════════════════════════════════════════════════════════

# ── MSSQL (4 databases) ────────────────────────────────────────
BASE_DB=mssql+pyodbc://<user>:<password>@<host>:<port>/<base_db>?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
PROD_DB=mssql+pyodbc://<user>:<password>@<prod_host>:<port>/<prod_db>?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
DIFF_STAGING_DB=mssql+pyodbc://<user>:<password>@<host>:<port>/<diff_staging_db>?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
DIFFMERGED_CONN=mssql+pyodbc://<user>:<password>@<host>:<port>/<diff_merged_db>?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# ── MySQL (3 databases) ────────────────────────────────────────
DEID_BASE_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<deid_base_db>
DEID_STAGING_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<deid_staging_db>
DEID_DIFFMERGED_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<deid_diffmerged_db>


# ══════════════════════════════════════════════════════════════
# DEID CONFIG
# ══════════════════════════════════════════════════════════════
DBDETAILSMODEL_NAME=<db_details_model_name>


# scripts/configs/{PROJECT_NAME}/config_incremental.yaml
PROJECT_NAME=
# ══════════════════════════════════════════════════════════════
# TABLES CSV (one per DAG)
# ══════════════════════════════════════════════════════════════
DIFF_MERGE_TABLES_CSV=/path/to/input/tables.csv
DEID_TABLES_CSV=/path/to/input/tables.csv
DEID_POST_PROCESS_TABLES_CSV=/path/to/input/tables.csv



# ══════════════════════════════════════════════════════════════
# AWS TRANSFER (aws_transfer.py)
# ══════════════════════════════════════════════════════════════
AWS_TRANSFER_MYSQL_HOST=<mysql_host>
AWS_TRANSFER_MYSQL_PORT=3306
AWS_TRANSFER_MYSQL_USER=<mysql_user>
AWS_TRANSFER_MYSQL_PASSWORD=<mysql_password>
AWS_TRANSFER_MYSQL_SCHEMA=<mysql_schema>
AWS_TRANSFER_MYSQLDUMP_PATH=/usr/bin/mysqldump
AWS_TRANSFER_MYSQL_PATH=/usr/bin/mysql
AWS_TRANSFER_S3_BUCKET=<s3_bucket_name>
AWS_TRANSFER_S3_PREFIX=<s3/prefix/path>
AWS_TRANSFER_S3_REGION=us-east-1
AWS_TRANSFER_AWS_ACCESS_KEY_ID=<aws_access_key_id>
AWS_TRANSFER_AWS_SECRET_ACCESS_KEY=<aws_secret_access_key>
AWS_TRANSFER_OUTPUT_BASE=/path/to/output/dir
AWS_TRANSFER_COUNT_SCHEMA=<deidentified_base>
AWS_TRANSFER_COUNT_REPORT_LABEL=<provider>_pt_tables
AWS_TRANSFER_COUNT_S3_PREFIX=EHR/merge_stats


# ══════════════════════════════════════════════════════════════
# MAPPING (incremental_mapping_update_v3/v4/v5.py)
# Set source_type in the YAML config to 'mssql' or 'mysql'
# ══════════════════════════════════════════════════════════════

# ── Source DB ─────────────────────────────────────────────────
MAPPING_SOURCE_HOST=<source_host>
MAPPING_SOURCE_PORT=1433
MAPPING_SOURCE_DATABASE=<source_database>
MAPPING_SOURCE_USER=<source_user>
MAPPING_SOURCE_PASSWORD=<source_password>

# ── Destination DB (always MySQL) ─────────────────────────────
MAPPING_DEST_HOST=localhost
MAPPING_DEST_DATABASE=<mapping_mysql_database>
MAPPING_DEST_USER=<mapping_mysql_user>
MAPPING_DEST_PASSWORD=<mapping_mysql_password>

# ── Path to the YAML config file ──────────────────────────────
MAPPING_CONFIG_FILE=/path/to/Airflow/scripts/configs/mapping_config.yaml

# ══════════════════════════════════════════════════════════════
# MASTER RECREATE (master_recreate_v3.py — works with v3 / v4 / v5)
# Connection strings — dialect prefix picks the driver automatically:
#   mssql+pymssql://<user>:<password>@<host>:<port>/<database>
#   mysql+pymysql://<user>:<password>@<host>:<port>/<database>
# ══════════════════════════════════════════════════════════════

# Source DB — where PII/master data is fetched from
MASTER_SOURCE_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<source_database>

# Destination MySQL — where pii_data_table / master_insurance_table are written
MASTER_DEST_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<dest_database>

# Mapping MySQL — where patient_mapping_table lives (can be same as destination)
MASTER_MAPPING_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<mapping_database>

# ══════════════════════════════════════════════════════════════
# DAG SCHEDULES (leave blank or omit for manual trigger only)
# ══════════════════════════════════════════════════════════════
DIFF_MERGE_SCHEDULE=
DEID_SCHEDULE=
DEID_POST_PROCESS_SCHEDULE=
AWS_TRANSFER_SCHEDULE=
