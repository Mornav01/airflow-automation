# ════════════════════════════════════════════════════════════════════════════
# AIRFLOW DEID — environment template
#
# TOP    : variables REQUIRED by the active mind-branch pipelines
#          (eCW / Greenway / MIND / dent).
# BOTTOM : everything after the ░░░ divider is NOT used by the active pipelines —
#          legacy athena/veradigm clients + manual utility scripts. Usually unset.
# ════════════════════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════
# PRACTICE IDENTITY  (set per-machine — drives client config YAML selection)
# ══════════════════════════════════════════════════════════════
# Greenway practices : mind | jwm | savannah
# eCW practices      : dent | northwest | texas | fcn | tncne | arizona
PRACTICE_NAME=<practice_name>

# ══════════════════════════════════════════════════════════════
# ALERTING
# ══════════════════════════════════════════════════════════════
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/<space>/messages?key=<key>&token=<token>

# ══════════════════════════════════════════════════════════════
# PRIMARY SOURCE-ENGINE KNOB  (set alongside PRACTICE_NAME above)
# ══════════════════════════════════════════════════════════════
# Engine of the CLIENT SOURCE database the pipeline READS: mysql | mssql.
# Drives every *_config_incremental/_historical.yaml `source_db` and the eCW /
# mind / greenway delta, decrypt and mapping/master scripts. The working and
# destination databases are ALWAYS MySQL regardless of this setting.
SOURCE_DB_TYPE=mysql

# Python executable for new deidentification code (new_deid conda env)
DEID_PYTHON=/opt/miniconda3/envs/new_deid/bin/python

# ══════════════════════════════════════════════════════════════
# STATE DIRECTORY
# ══════════════════════════════════════════════════════════════
STATE_DIR=/path/to/airflow-automation/state

# Path to the deid engine repo (deidentification_v2) — used by the `deid` CLI,
# the dent CDC scripts (CDC/MySQL), and the state init/status scripts.
DEID_REPO_DIR=/path/to/deidentification_v2/

# ══════════════════════════════════════════════════════════════
# MERGE CONFIG
# ══════════════════════════════════════════════════════════════
PK_CSV=/path/to/input/primary_keys.csv
HISTORICAL_DATA_DEFAULT_DATE=2026-03-11 00:00:00

# ══════════════════════════════════════════════════════════════
# DATABASE CONNECTIONS  (primitives — db_config.py + the YAML configs build
# every connection string / dict from these; there are no full conn-strings here)
# ══════════════════════════════════════════════════════════════

# ── SOURCE DB — the client's data, READ side (engine = SOURCE_DB_TYPE) ──
# SOURCE_DB_HOST falls back to DB_HOST when blank (the source is usually local).
SOURCE_DB_HOST=
SOURCE_DB_PORT=3306
SOURCE_DB_USER=<source_db_user>
SOURCE_DB_PASS=<source_db_password>
# ODBC driver — used only when SOURCE_DB_TYPE=mssql (pyodbc). URL-encoded into
# every MSSQL connection in code. `odbcinst -q -d` lists installed drivers.
ODBC_DRIVER=ODBC Driver 17 for SQL Server

# ── WORKING / DESTINATION DB — ALWAYS MySQL, WRITE side ─────────
# deid staging + mapping + master tables are always written here.
DB_HOST=<mysql_working_host>
DB_PORT=3306
DB_USER=<mysql_user>
DB_PASS=<mysql_password>

# ── UPSTREAM PROD MSSQL — remote source for mapping/master delta (greenway/mind) ──
# Reuses SOURCE_DB_USER / SOURCE_DB_PASS / SOURCE_DB_PORT + ODBC_DRIVER.
# Falls back to SOURCE_DB_HOST → DB_HOST when blank. Leave blank for local sources.
PROD_HOST=

# ══════════════════════════════════════════════════════════════
# SQL FILES
# ══════════════════════════════════════════════════════════════
MAPPING_SQL_FILE=/path/to/Airflow/scripts/sql/mapping_greenway.sql
MASTER_PII_SQL_FILE=/path/to/Airflow/scripts/sql/master_pii_data_query_greenway.sql
MASTER_INSURANCE_SQL_FILE=/path/to/Airflow/scripts/sql/master_insurance_query_greenway.sql

# ══════════════════════════════════════════════════════════════
# DEID CONFIG
# ══════════════════════════════════════════════════════════════
# Days to shift dates during de-identification (integer)
DATE_OFFSET=<days_to_offset_dates>
# Local directory for deid state DB (state.db) and run logs
LOG_DIR=/path/to/airflow-automation/deid_logs

# ══════════════════════════════════════════════════════════════
# DATABASE SCHEMA NAMES  (used as string args to scripts and YAML configs)
# ══════════════════════════════════════════════════════════════
# ── MSSQL schema names ─────────────────────────────────────────
STAGING_DB_NAME=<mssql_staging_schema>
MERGED_DB_NAME=<mssql_diff_merged_db>
PROD_DB_NAME=<mssql_production_db>
# ── MySQL schema names ─────────────────────────────────────────
MAPPING_DB_NAME=mapping
MASTER_DB_NAME=master
DEID_STAGING_NAME=deidentified_staging
DEID_BASE_NAME=<deid_base_db_name>
# ── eCW-specific schema names ──────────────────────────────────
PROD_SCHEMA=<ecw_production_schema>
STAGING_SCHEMA=<ecw_staging_schema>
# ── Greenway-specific schema names ─────────────────────────────
CLINICALBIN_DB_NAME=<clinicalbin_decrypted_mysql_db>

# ══════════════════════════════════════════════════════════════
# TABLES CSV (one per DAG)
# ══════════════════════════════════════════════════════════════
DIFF_MERGE_TABLES_CSV=/path/to/input/tables.csv
DEID_TABLES_CSV=/path/to/input/tables.csv
DEID_POST_PROCESS_TABLES_CSV=/path/to/input/tables.csv
CLINICALBIN_TABLES_CSV=/path/to/input/clinicalbin_tables.csv

# ══════════════════════════════════════════════════════════════
# DEID YAML CONFIG PATHS  (substituted into config YAML files via ${VAR})
# ══════════════════════════════════════════════════════════════
# Rules CSVs — define which columns are PHI and how to de-identify them
RULES_CSV=/path/to/scripts/greenway/greenway_config_rules.csv
CNOTES_RULES_CSV=/path/to/scripts/greenway/cnotes_config_rules.csv
# PII config YAMLs — point to the correct EHR folder on each machine
PII_YAML=/path/to/scripts/greenway/greenway_pii_config.yaml
SECONDARY_PII_YAML=/path/to/scripts/greenway/greenway_secondary_pii_config.yaml
REF_MAPPING_YAML=/path/to/scripts/greenway/greenway_reference_mappings.yaml

# Per-client facility redactions injected into every pii_config's `replace_value`.
# A JSON list of {old_value, new_value} dicts, parsed by the deid config loader
# (a whole-value ${VAR} that is valid JSON is expanded to the list). Values differ
# per client — set this on each machine. Example below is for the Dent (eCW) practice:
REPLACE_VALUE_JSON=[{"old_value": "Dent Institute", "new_value": "((FACILITYNAME))"}, {"old_value": "DENT", "new_value": "((FACILITYNAME))"}, {"old_value": "www.dentinstitute.com", "new_value": "((FACILITY_WEBSITE))"}]

# ══════════════════════════════════════════════════════════════
# SMB DUMP  (daily_dump.py — set per-machine in .env, values differ per practice)
#
#   Greenway / Mind   : SMB_SHARE=mind-sql/SQL Backups    SMB_SOURCE_FOLDER_NAME=SQLBackups
#   eCW               : SMB_SHARE=cns-ecw-db01/SQL_Backups  SMB_SOURCE_FOLDER_NAME=CNS-ECW-DB01
# ══════════════════════════════════════════════════════════════
SMB_SHARE=<host>/<share_name>
SMB_USERNAME=<smb_username>
SMB_PASSWORD=<smb_password>
SMB_SOURCE_FOLDER_NAME=<source_folder_on_smb_share>

# ══════════════════════════════════════════════════════════════
# MSSQL LOG RESTORE  (restore_incremental_logs.py — applies .trn logs via sqlcmd)
# ══════════════════════════════════════════════════════════════
# Directory holding the .trn transaction-log files to apply
DATA_LOGS_DIR=/path/to/airflow-automation/deid_runtime/dataLogs
# Dry run: 1/true/yes = log intended actions without applying
RESTORE_DRY_RUN=0
# sqlcmd target host/container + SA auth
SQL_SERVER_CONTAINER=localhost
SQLCMD_CONTAINER=<sqlcmd_container_id_or_name>
SA_USER=sa
SA_PASS=<mssql_sa_password>
SQLCMD_BIN=/opt/mssql-tools18/bin/sqlcmd

# ══════════════════════════════════════════════════════════════
# CLINICAL NOTES DECRYPT  (greenway/decrypt_cnotes.py + clinicalbin_delta_staging.py)
# ══════════════════════════════════════════════════════════════
# Source MSSQL connection for raw (encrypted) cnotes.
# The ODBC driver is applied from ODBC_DRIVER (above) in code — no need to set
# driver= here; anything you put will be overridden to match ODBC_DRIVER.
CNOTES_SOURCE_CONN=mssql+pyodbc://<user>:<password>@<host>:<port>/<db>
# Dest MySQL connection for decrypted cnotes staging
CNOTES_DEST_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<db>
# Linked server name on the MSSQL side (default: Primerecord_Latest)
CNOTES_LINKED_DB=Primerecord_Latest
# Optional: override batch size (default set in script)
CNOTES_BATCH_SIZE=500

# ══════════════════════════════════════════════════════════════
# SOURCE DATABASE ENGINE  (configured at the top of this file)
# ══════════════════════════════════════════════════════════════
# The source engine + credentials live in SOURCE_DB_TYPE and the SOURCE_DB_*
# family near the top. All client-source configs (*_config_incremental /
# *_config_historical.yaml) and the eCW / mind / greenway delta, decrypt and
# mapping/master scripts read from those. mysql → SOURCE_DB_PORT=3306 ;
# mssql → SOURCE_DB_PORT=1433 (+ ODBC_DRIVER). Nothing to set in this section.

# ══════════════════════════════════════════════════════════════
# DECRYPTION KEY  (decrypt_pnotes.py · state_diff_decryption.py · manual_decryption.py)
# ══════════════════════════════════════════════════════════════
# Quote the value if it contains special characters such as # or @.
DEID_DECRYPT_KEY="<blowfish_decryption_key>"

# ══════════════════════════════════════════════════════════════
# AWS S3 TRANSFER  (s3_transfer.py · task_s3_transfer in all pipeline DAGs)
# ══════════════════════════════════════════════════════════════
AWS_ACCESS_KEY_ID=<aws_access_key_id>
AWS_SECRET_ACCESS_KEY=<aws_secret_access_key>
AWS_REGION=<aws_region>
S3_BUCKET=<s3_bucket_name>
# Local staging directory where deidentified data is written before S3 upload
DATA_TRANSFER_BASE_PATH=/Volumes/NDAIVol/S3 Transfer

# ══════════════════════════════════════════════════════════════
# ADDITIONAL ACTIVE-PIPELINE VARS  (all have code defaults — set to override)
# ══════════════════════════════════════════════════════════════
# db_config.py connection-string components (PROD_HOST is in the DATABASE
# CONNECTIONS section above — remote-prod host for mapping/master delta).
BASE_DB_NAME=<mssql_base_db>
DEID_MERGED_NAME=deidentified_merged

# dent CDC pipeline (dags/dent/cdc_automation_dag.py)
DB_CDC_SCHEMA=cdc
SOURCE_SCHEMA=<dent_source_schema>

# Provider dashboard DAG (dags/mind/provider_dashboard.py)
DASHBOARD_PROJECT_DIR=/path/to/dashboards

# Standalone MSSQL log/backup restore (scripts/restore_incremental_logs.py · restore_backups.py)
RESTORE_LOGS_DB=<mssql_db_being_restored>
STANDBY_FILE=/var/opt/mssql/undo/<db>_standby.undo
TRN_DIR=/var/opt/mssql/backups
TRN_GLOB=*.trn
APPLIED_LOGS_FILE=/path/to/airflow-automation/deid_runtime/dataLogs/applied_logs.csv
BAK_DIR=/var/opt/mssql/dump/Full


# ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
# BELOW THIS LINE — NOT required by the active mind-branch pipelines
# (eCW / Greenway / MIND / dent). Legacy clients + manual utilities only.
# Leave these unset on machines that run only the active pipelines.
# ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░

# ══════════════════════════════════════════════════════════════
# LEGACY — athena / athenapractice / veradigm clients on the v3/v4/v5 engine
#   (incremental_mapping_update_v3/v4/v5.py · master_recreate_v3.py · athenaone/*)
# Role-based connection vars read by db_config's legacy compatibility shim.
# ══════════════════════════════════════════════════════════════
# Mapping engine — source DB (mssql OR mysql) + destination (always MySQL)
MAPPING_SOURCE_HOST=<legacy_source_host>
MAPPING_SOURCE_PORT=1433
MAPPING_SOURCE_DATABASE=<legacy_source_db>
MAPPING_SOURCE_USER=<legacy_source_user>
MAPPING_SOURCE_PASSWORD=<legacy_source_password>
MAPPING_DEST_HOST=<legacy_dest_mysql_host>
MAPPING_DEST_DATABASE=<legacy_mapping_mysql_db>
MAPPING_DEST_USER=<legacy_dest_user>
MAPPING_DEST_PASSWORD=<legacy_dest_password>
MAPPING_CONFIG_FILE=/path/to/Airflow/scripts/configs/<client>/mapping_master_config_<client>.yaml
# Master recreate — full SQLAlchemy connection strings
MASTER_SOURCE_CONN=mssql+pymssql://<user>:<password>@<host>:<port>/<source_db>
MASTER_DEST_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<master_db>
MASTER_MAPPING_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<mapping_db>
# DB-details model name — only the removed Django/polar runner used this
DBDETAILSMODEL_NAME=<db_details_model_name>

# ══════════════════════════════════════════════════════════════
# MANUAL / UTILITY SCRIPTS  (not used by Airflow DAGs)
# ══════════════════════════════════════════════════════════════

# diff_script_optimised.py · diff_script_duplicate_pk_handled.py
MSSQL_OLD_CONN=mssql+pyodbc://<user>:<password>@<host>:<port>/<old_db>?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
MSSQL_NEW_CONN=mssql+pyodbc://<user>:<password>@<host>:<port>/<new_db>?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
MSSQL_DIFF_CONN=mssql+pyodbc://<user>:<password>@<host>:<port>/<diff_db>?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes

# row_count_comparison.py
MSSQL_CONN=mssql+pyodbc://<user>:<password>@<host>:<port>/<db>?driver=ODBC+Driver+17+for+SQL+Server
MYSQL_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<db>

# deid_output_comparison.py
MYSQL_OLD_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<old_deid_db>
MYSQL_NEW_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<new_deid_db>
MYSQL_DIFF_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<diff_db>

# gcp_count.py (adhoc)
MYSQL_PASSWORD=<mysql_password>
