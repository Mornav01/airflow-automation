# ══════════════════════════════════════════════════════════════
# DEID V2 CREDENTIALS (used by scripts/configs/config.yaml)
# ══════════════════════════════════════════════════════════════
SOURCE_USER=<mssql_source_username>
SOURCE_PW=<mssql_source_password>
DEST_USER=<mysql_dest_username>
DEST_PW=<mysql_dest_password>

# Python executable for new deidentification code (new_deid conda env)
DEID_PYTHON=/opt/miniconda3/envs/new_deid/bin/python

# ══════════════════════════════════════════════════════════════
# STATE DIRECTORY
# ══════════════════════════════════════════════════════════════
STATE_DIR=/path/to/airflow-automation/state

# Path to old polar deidentification code
DEID_REPO_DIR=/path/to/deidentification_v2/

# ══════════════════════════════════════════════════════════════
# MERGE CONFIG
# ══════════════════════════════════════════════════════════════
PK_CSV=/path/to/input/primary_keys.csv
HISTORICAL_DATA_DEFAULT_DATE=2026-03-11 00:00:00

# ══════════════════════════════════════════════════════════════
# DATABASE CONNECTION STRINGS
# ══════════════════════════════════════════════════════════════

# ── MSSQL (4 databases) ────────────────────────────────────────
BASE_DB=mssql+pyodbc://<user>:<password>@<host>:<port>/<base_db>?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
PROD_DB=mssql+pyodbc://<user>:<password>@<prod_host>:<port>/<prod_db>?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
DIFF_STAGING_DB=mssql+pyodbc://<user>:<password>@<host>:<port>/<diff_staging_db>?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
DIFFMERGED_CONN=mssql+pyodbc://<user>:<password>@<host>:<port>/<diff_merged_db>?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# ── MySQL (3 databases) ────────────────────────────────────────
DEID_BASE_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<deid_base_db>
DEID_STAGING_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<deid_staging_db>
DEID_DIFFMERGED_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<deid_diffmerged_db>

# ══════════════════════════════════════════════════════════════
# MAPPING — dict-style (mssql_incremental_mapping_update.py
#                    + mssql_incremental_mapping_update_activeflag.py)
# ══════════════════════════════════════════════════════════════
MAPPING_MSSQL_SERVER=<prod_mssql_host>
MAPPING_MSSQL_PORT=1433
MAPPING_MSSQL_DATABASE=<prod_mssql_database>
MAPPING_MSSQL_USER=<prod_mssql_user>
MAPPING_MSSQL_PASSWORD=<prod_mssql_password>
MAPPING_MYSQL_HOST=localhost
MAPPING_MYSQL_DATABASE=<mapping_mysql_database>
MAPPING_MYSQL_USER=<mapping_mysql_user>
MAPPING_MYSQL_PASSWORD=<mapping_mysql_password>

# ══════════════════════════════════════════════════════════════
# MASTER RECREATE — connection string style (mssql_incremental_master_recreate.py)
# ══════════════════════════════════════════════════════════════
MASTER_MSSQL_CONN=mssql+pymssql://<user>:<password>@<prod_host>:<port>/<prod_db>
MASTER_MYSQL_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<master_db>

# ══════════════════════════════════════════════════════════════
# SQL FILES
# ══════════════════════════════════════════════════════════════
MAPPING_SQL_FILE=/path/to/Airflow/scripts/sql/mapping_greenway.sql
MASTER_PII_SQL_FILE=/path/to/Airflow/scripts/sql/master_pii_data_query_greenway.sql
MASTER_INSURANCE_SQL_FILE=/path/to/Airflow/scripts/sql/master_insurance_query_greenway.sql

# ══════════════════════════════════════════════════════════════
# DEID CONFIG
# ══════════════════════════════════════════════════════════════
DBDETAILSMODEL_NAME=<db_details_model_name>

# ══════════════════════════════════════════════════════════════
# TABLES CSV (one per DAG)
# ══════════════════════════════════════════════════════════════
DIFF_MERGE_TABLES_CSV=/path/to/input/tables.csv
DEID_TABLES_CSV=/path/to/input/tables.csv
DEID_POST_PROCESS_TABLES_CSV=/path/to/input/tables.csv

# ══════════════════════════════════════════════════════════════
# GCP TRANSFER (gcp_transfer.py)
# ══════════════════════════════════════════════════════════════
GCP_TRANSFER_MYSQL_HOST=<mysql_host>
GCP_TRANSFER_MYSQL_PORT=3306
GCP_TRANSFER_MYSQL_USER=<mysql_user>
GCP_TRANSFER_MYSQL_PASSWORD=<mysql_password>
GCP_TRANSFER_MYSQL_SCHEMA=<mysql_schema>
GCP_TRANSFER_MYSQLDUMP_PATH=/usr/bin/mysqldump
GCP_TRANSFER_MYSQL_PATH=/usr/bin/mysql
GCP_TRANSFER_GCS_BUCKET=<gcs_bucket_name>
GCP_TRANSFER_GCS_PREFIX=<gcs/prefix/path>
GCP_TRANSFER_OUTPUT_BASE=/path/to/output/dir

# ══════════════════════════════════════════════════════════════
# V2 MAPPING — dict-style (mssql_incremental_mapping_update_v2.py)
# ══════════════════════════════════════════════════════════════
V2_MAPPING_MSSQL_SERVER=<prod_mssql_host>
V2_MAPPING_MSSQL_PORT=1433
V2_MAPPING_MSSQL_DATABASE=<prod_mssql_database>
V2_MAPPING_MSSQL_USER=<prod_mssql_user>
V2_MAPPING_MSSQL_PASSWORD=<prod_mssql_password>
V2_MAPPING_MYSQL_HOST=localhost
V2_MAPPING_MYSQL_DATABASE=<mapping_mysql_database>
V2_MAPPING_MYSQL_USER=<mapping_mysql_user>
V2_MAPPING_MYSQL_PASSWORD=<mapping_mysql_password>

# ── V2 Master recreate — connection string style ───────────────
V2_MASTER_MSSQL_CONN=mssql+pymssql://<user>:<password>@<prod_host>:<port>/<prod_db>
V2_MASTER_MYSQL_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<master_db>
V2_MASTER_MAPPING_MYSQL_CONN=mysql+pymysql://<user>:<password>@<host>:<port>/<mapping_db>

# ── V2 SQL files ───────────────────────────────────────────────
V2_MAPPING_SQL_FILE=/path/to/Airflow/scripts/sql/mapping_noran.sql
V2_MASTER_PII_SQL_FILE=/path/to/Airflow/scripts/sql/master_pii_data_query_noran.sql
V2_MASTER_INSURANCE_SQL_FILE=/path/to/Airflow/scripts/sql/master_insurance_query_noran.sql

# ── V2 Identifier columns ──────────────────────────────────────
# Comma-separated list matching the patient SQL column aliases
V2_MAPPING_PATIENT_IDENTIFIER_COLUMNS=patientid,profileid,pid
V2_MASTER_PII_DATA_JOIN_COLUMN=patientid
V2_MASTER_INSURANCE_JOIN_COLUMN=profileid

# ══════════════════════════════════════════════════════════════
# AWS TRANSFER (aws_transfer.py)
# ══════════════════════════════════════════════════════════════
AWS_TRANSFER_MYSQL_HOST=<mysql_host>
AWS_TRANSFER_MYSQL_PORT=3306
AWS_TRANSFER_MYSQL_USER=<mysql_user>
AWS_TRANSFER_MYSQL_PASSWORD=<mysql_password>
AWS_TRANSFER_MYSQL_SCHEMA=<mysql_schema>
AWS_TRANSFER_MYSQLDUMP_PATH=/usr/bin/mysqldump
AWS_TRANSFER_MYSQL_PATH=/usr/bin/mysql
AWS_TRANSFER_S3_BUCKET=<s3_bucket_name>
AWS_TRANSFER_S3_PREFIX=<s3/prefix/path>
AWS_TRANSFER_S3_REGION=us-east-1
AWS_TRANSFER_AWS_ACCESS_KEY_ID=<aws_access_key_id>
AWS_TRANSFER_AWS_SECRET_ACCESS_KEY=<aws_secret_access_key>
AWS_TRANSFER_OUTPUT_BASE=/path/to/output/dir

# ══════════════════════════════════════════════════════════════
# V3 MAPPING (mssql_incremental_mapping_update_v3.py)
# ══════════════════════════════════════════════════════════════

# ── Source DB (set source_type in the YAML config to 'mssql' or 'mysql') ──
V3_MAPPING_SOURCE_HOST=<source_host>
V3_MAPPING_SOURCE_PORT=1433
V3_MAPPING_SOURCE_DATABASE=<source_database>
V3_MAPPING_SOURCE_USER=<source_user>
V3_MAPPING_SOURCE_PASSWORD=<source_password>

# ── Destination DB (always MySQL) ─────────────────────────────
V3_MAPPING_MYSQL_HOST=localhost
V3_MAPPING_MYSQL_DATABASE=<mapping_mysql_database>
V3_MAPPING_MYSQL_USER=<mapping_mysql_user>
V3_MAPPING_MYSQL_PASSWORD=<mapping_mysql_password>

# ── Path to the YAML config file for v3 mapping ───────────────
V3_MAPPING_CONFIG_FILE=/path/to/Airflow/scripts/configs/mapping_config_noran.yaml

# ══════════════════════════════════════════════════════════════
# DAG SCHEDULES (leave blank or omit for manual trigger only)
# ══════════════════════════════════════════════════════════════
DIFF_MERGE_SCHEDULE=
DEID_SCHEDULE=
DEID_POST_PROCESS_SCHEDULE=
AWS_TRANSFER_SCHEDULE=
GCP_TRANSFER_SCHEDULE=
